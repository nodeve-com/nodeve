{
	"name": "@nodeve/web-form",
	"version": "0.1.0",
	"description": "Server-side spam defenses for public forms: Cloudflare Turnstile verification and a honeypot field.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nodeve-com/nodeve.git",
		"directory": "packages/web-form"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		"./honeypot": {
			"types": "./dist/honeypot.d.ts",
			"default": "./dist/honeypot.js"
		},
		"./turnstile": {
			"types": "./dist/turnstile.d.ts",
			"default": "./dist/turnstile.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist",
		"check": "pnpm typecheck",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@nodeve/config": "workspace:*",
		"typescript": "catalog:ts7",
		"vitest": "catalog:"
	}
}
